# ==========================================================
#  AMARTE STUDIO — site statique (HTML/CSS/JS)
#  Hébergement cPanel / Apache
#
#  ⚠ Ce fichier REMPLACE le .htaccess de WordPress.
#    Ne pas fusionner les deux : les règles de réécriture de
#    WordPress renvoient toutes les URL vers index.php, ce qui
#    donnerait des 404 sur tarifs.html, cours.html, etc.
# ==========================================================

# ── Page d'accueil ────────────────────────────────────────
DirectoryIndex index.html

# ── Pas de listing des dossiers ───────────────────────────
Options -Indexes

# ── Encodage par défaut ───────────────────────────────────
AddDefaultCharset UTF-8


# ══ REDIRECTIONS ══════════════════════════════════════════
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validation SSL (AutoSSL / Let's Encrypt) : laisser passer en
  # HTTP, sinon le renouvellement du certificat échoue.
  RewriteRule ^\.well-known/ - [L]

  # HTTP → HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www → sans www (l'URL canonique du sitemap est https://amarte.ch)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]


  # ── ADRESSES SANS EXTENSION ─────────────────────────────
  # Le site s'écrit en fichiers .html mais se lit sans : /cours,
  # pas /cours.html. Chaque page n'a donc qu'une seule adresse —
  # c'est plus lisible, et Google n'a pas deux versions à départager.

  # 1. /index.html et /cours.html renvoient vers l'adresse courte.
  #    La condition porte sur la requête d'origine, pas sur le
  #    chemin réécrit : sans elle, l'étape 4 rouvrirait la boucle.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2. /cours/ renvoie vers /cours. La barre finale casserait les
  #    chemins relatifs de la page (css/, js/, public/).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/$ /$1 [R=301,L]

  # 3. Anciennes adresses WordPress dont le nom a changé. La liste
  #    est volontairement large : une redirection de trop ne coûte
  #    rien, une manquante coûte une page.
  RewriteRule ^(a-propos|qui-sommes-nous|le-studio|studio)/?$                 /apropos [R=301,L,NC]
  RewriteRule ^(planning|horaires|reservation|reserver)/?$                    /calendrier [R=301,L,NC]
  RewriteRule ^(tarif|prix|abonnement|abonnements)/?$                         /tarifs [R=301,L,NC]
  RewriteRule ^(nous-contacter|acces|contactez-nous)/?$                       /contact [R=301,L,NC]
  RewriteRule ^(entreprise|entreprises|corporate|bien-etre-en-entreprise)/?$  /corpo [R=301,L,NC]
  RewriteRule ^(louer-la-salle|salle|location-de-salle|location-salle)/?$     /location [R=301,L,NC]
  RewriteRule ^(debuter|debutant|commencer|nouveau|premiere-visite)/?$        /premiere-fois [R=301,L,NC]
  RewriteRule ^(yoga|pilates|nos-cours|les-cours|disciplines)/?$              /cours [R=301,L,NC]

  # 4. Enfin, /cours sert cours.html — sans redirection, l'adresse
  #    affichée reste courte. Tout le reste tombe sur la page 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)$ /$1.html [L]

</IfModule>


# ══ PAGE D'ERREUR ═════════════════════════════════════════
# Une ancienne adresse sans équivalent atterrit sur une vraie page
# du site plutôt que sur le mur d'Apache.
ErrorDocument 404 /404.html


# ══ TYPES MIME ════════════════════════════════════════════
# Certains serveurs ne connaissent pas encore woff2.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>


# ══ COMPRESSION ═══════════════════════════════════════════
# Les polices woff/woff2 sont déjà compressées : ne pas les
# repasser dans gzip, ce serait du travail pour rien.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ══ CACHE NAVIGATEUR ══════════════════════════════════════
<IfModule mod_expires.c>
  ExpiresActive On

  # Polices — jamais modifiées, cache long.
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"

  # Images — cache long.
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon  "access plus 1 year"

  # CSS / JS — 1 semaine. Volontairement court : les fichiers
  # sont édités en place (pas de hash dans le nom), un cache
  # d'un an bloquerait les mises à jour chez les visiteurs.
  ExpiresByType text/css               "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript        "access plus 1 week"

  # HTML — jamais mis en cache : les modifications de contenu
  # doivent être visibles immédiatement.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Les polices sont immuables : le navigateur ne revalide pas.
  <FilesMatch "\.(woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Le HTML est revalidé à chaque visite.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>


# ══ SÉCURITÉ ══════════════════════════════════════════════
<IfModule mod_headers.c>
  # Empêche l'affichage du site dans une iframe tierce.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Empêche le navigateur de deviner un type MIME.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# spam-filter.php est inclus par contact.php, jamais appelé
# directement. Il refuse déjà de s'exécuter seul (garde en tête de
# fichier) ; cette règle évite en plus qu'un serveur mal configuré
# en serve le code source en clair.
<Files "spam-filter.php">
  Require all denied
</Files>

# Dossier de travail de l'antispam : compteurs, empreintes et
# journal des décisions. Il est normalement créé AU-DESSUS de la
# racine web ; cette règle couvre le cas où l'hébergement ne le
# permet pas et où il retombe ici.
RedirectMatch 404 ^/antispam-donnees(/|$)

# Bloque l'accès aux fichiers cachés (.git, .env, .htaccess…)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Le dépôt Git ne doit jamais être exposé.
RedirectMatch 404 /\.git
